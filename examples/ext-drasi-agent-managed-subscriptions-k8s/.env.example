# An Azure OpenAI v1 base URL or its /responses or /chat/completions URL is accepted.
# The agent uses the v1 Chat Completions API and requires tool-calling support.
# Keep the deployment on a fixed model version for a reproducible demonstration.
LLM_PROVIDER=azure
LLM_CHAT_URL=https://YOUR-RESOURCE.openai.azure.com/openai/v1/
LLM_API_KEY=
LLM_MODEL=YOUR-DEPLOYMENT
